# CartGuard AI - Environment Configuration Example
# Per MASTER_PROMPT.md Section 17: Docker Compose and Local Developer Experience
# Copy this file to .env.local and customize for your environment

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
API_PORT=8000
API_HOST=0.0.0.0

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (Transactional State)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cartguard
POSTGRES_USER=cartguard
POSTGRES_PASSWORD=cartguard_local_only
DATABASE_URL=postgresql://cartguard:cartguard_local_only@localhost:5432/cartguard?schema=public

# ─────────────────────────────────────────────────────────────────────────────
# Redis (Cache, Budget State, Kill Switches)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# Kafka/Redpanda (Durable Event Stream)
# ─────────────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=cartguard-api
KAFKA_GROUP_ID=cartguard-workers
KAFKA_TOPIC_EVENTS=cartguard.events
KAFKA_TOPIC_DECISIONS=cartguard.decisions
KAFKA_TOPIC_EXPOSURES=cartguard.exposures
KAFKA_TOPIC_OUTCOMES=cartguard.outcomes

# ─────────────────────────────────────────────────────────────────────────────
# Authentication & Authorization
# ─────────────────────────────────────────────────────────────────────────────
# OIDC configuration (for merchant console, not browser SDK)
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=cartguard-local
OIDC_CLIENT_SECRET=local_development_secret_not_for_production

# API Keys (for browser SDK)
# Demo tenant publishable key (prefix: pk_test_ for test mode)
DEMO_TENANT_PUBLISHABLE_KEY=pk_test_demo_cartguard_local_development_key

# ─────────────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=cartguard-api
OTEL_SERVICE_VERSION=1.0.0

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags & Kill Switches
# ─────────────────────────────────────────────────────────────────────────────
# Global kill switch (overrides all other settings)
GLOBAL_KILL_SWITCH=false

# Feature flags
ENABLE_EXPERIMENTS=true
ENABLE_MODEL_INFERENCE=false
ENABLE_BANDIT_ALLOCATION=false

# ─────────────────────────────────────────────────────────────────────────────
# Decision Engine
# ─────────────────────────────────────────────────────────────────────────────
# Timeouts (milliseconds)
DECISION_TIMEOUT_MS=600
MODEL_TIMEOUT_MS=200
FEATURE_TIMEOUT_MS=100
REDIS_TIMEOUT_MS=50

# Feature freshness (seconds)
FEATURE_MAX_AGE_SECONDS=300

# ─────────────────────────────────────────────────────────────────────────────
# ML Models & Feature Store (Phase 4)
# ─────────────────────────────────────────────────────────────────────────────
MODEL_REGISTRY_URL=http://localhost:8001
FEATURE_STORE_URL=http://localhost:8002
MODEL_VERSION=baseline_v1

# ─────────────────────────────────────────────────────────────────────────────
# CORS & Security
# ─────────────────────────────────────────────────────────────────────────────
# Allowed origins for browser SDK (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_MAX_AGE_SECONDS=3600

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# ─────────────────────────────────────────────────────────────────────────────
# Development & Testing
# ─────────────────────────────────────────────────────────────────────────────
# Seed data
SEED_DEMO_TENANT=true
DEMO_TENANT_ID=ten_01demo00000000000000000
DEMO_SHOP_ID=shop_01demo00000000000000000

# Test mode settings
TEST_MODE=false
BYPASS_CONSENT_CHECK=false
BYPASS_ORIGIN_CHECK=false
